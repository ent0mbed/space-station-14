<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../bin/Content.Replay.Diagnostic/</OutputPath>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningsAsErrors>RA0032;nullable</WarningsAsErrors>
  </PropertyGroup>
  <Import Project="../MSBuild/Content.props" />
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="8589934592" />
    <PackageReference Include="prometheus-net" />
    <ProjectReference Include="../Content.Client/Content.Client.csproj" />
    <ProjectReference Include="../Content.Shared/Content.Shared.csproj" />
  </ItemGroup>
  <Import Project="../RobustToolbox/MSBuild/Robust.Properties.targets" />
  <Import Project="../RobustToolbox/Imports/Client.props" />
  <Import Project="../RobustToolbox/Imports/Shared.props" />
  <!-- Robust.Client is a library dependency here. Its referenced RID and portable
       builds can both offer executable files; only this reader owns an apphost. -->
  <Target Name="KeepReaderPublishEntryPoint" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.RelativePath)' == 'Robust.Client' Or
                   '%(ResolvedFileToPublish.RelativePath)' == 'Robust.Client.exe' Or
                   '%(ResolvedFileToPublish.RelativePath)' == 'Robust.Client.deps.json' Or
                   '%(ResolvedFileToPublish.RelativePath)' == 'Robust.Client.runtimeconfig.json'" />
    </ItemGroup>
  </Target>
</Project>
