+using System.Threading;
+
+namespace Robust.Client.GameObjects;
+
+public sealed partial class SpriteComponent
+{
+    // Diagnostic-only, neither serialized nor networked. A replacement component
+    // gets a new identity even when both components have revision zero.
+    private static long _nextReplayAnimationIdentity;
+    public long ReplayAnimationIdentity { get; } = Interlocked.Increment(ref _nextReplayAnimationIdentity);
+
+    private long _replayAnimationEligibilityRevision;
+    public long ReplayAnimationEligibilityRevision => Volatile.Read(ref _replayAnimationEligibilityRevision);
+
+    internal void InvalidateReplayAnimationEligibility()
+        => Interlocked.Increment(ref _replayAnimationEligibilityRevision);
+}
