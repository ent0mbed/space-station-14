+/// <summary>Named, immutable admission policies; not part of native serialization.</summary>
+public sealed class ReplayClipProfile
+{
+    public static readonly ReplayClipProfile TenSecond = new("ten-second", 10, 601, 32, null);
+    public static readonly ReplayClipProfile MinutePreview = new("minute-preview", 60, 1801, 64, 30);
+
+    public string Name { get; }
+    public TimeSpan MaxDuration { get; }
+    public int MaxStates { get; }
+    public int MaxBlocks { get; }
+    public int? RequiredTickRate { get; }
+
+    private ReplayClipProfile(string name, int seconds, int states, int blocks, int? tickRate)
+    {
+        if (seconds <= 0 || states <= 0 || blocks <= 0
+            || tickRate is { } rate && (rate <= 0 || states != checked(seconds * rate + 1)))
+            throw new ArgumentException("Inconsistent clip profile limits.");
+        Name = name;
+        MaxDuration = TimeSpan.FromSeconds(seconds);
+        MaxStates = states;
+        MaxBlocks = blocks;
+        RequiredTickRate = tickRate;
+    }
+
+    public void ValidateTickRate(int rate)
+    {
+        if (RequiredTickRate is { } required && rate != required)
+            throw new InvalidDataException($"{Name} requires a constant {required} Hz replay; observed {rate} Hz.");
+    }
+
+    public void ValidateMessages(ReplayMessage? messages)
+    {
+        if (RequiredTickRate == null || messages == null)
+            return;
+        // Check every assignment: checkpoint generation consumes messages in reverse order.
+        foreach (var message in messages.Messages)
+            if (message is ReplayMessage.CvarChangeMsg change)
+                foreach (var (key, value) in change.ReplicatedCvars)
+                    if (key == CVars.NetTickrate.Name)
+                        ValidateTickRate((int) value);
+    }
+}
+
+/// <summary>Bounded counters for the diagnostic exporter; not part of native serialization.</summary>
+public sealed class ReplayClipDiagnostics
+{
+    public ReplayClipProfile Profile { get; }
+    public const int MaxBlockBytes = 64 * 1024 * 1024;
+    public const long MaxDecodedBytes = 256L * 1024 * 1024;
+
+    public ReplayClipDiagnostics(ReplayClipProfile? profile = null)
+    {
+        Profile = profile ?? ReplayClipProfile.TenSecond;
+    }
+
+    public int BlocksRead;
+    public long DecodedBytes;
+    public double ReadMilliseconds;
+    public double PlaybackReadMilliseconds;
+    public int PlaybackBlocksRead;
+}
