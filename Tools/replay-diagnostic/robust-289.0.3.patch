+{
+    public ReplayClipProfile Profile { get; }
+    public const int MaxBlockBytes = 64 * 1024 * 1024;
+    public const long MaxDecodedBytes = 256L * 1024 * 1024;
+
+    public ReplayClipDiagnostics(ReplayClipProfile? profile = null)
+    {
+        Profile = profile ?? ReplayClipProfile.TenSecond;
+    }
+
+    public int BlocksRead;
+    public long DecodedBytes;
+    public double ReadMilliseconds;
+    public double PlaybackReadMilliseconds;
+    public int PlaybackBlocksRead;
+}

