+using System.Collections.Generic;
+
+namespace Robust.Client.Graphics;
+
+/// <summary>Converter-owned, read-only headless recording seam at engine 289.0.3.</summary>
+public interface IReplayShaderSnapshot
+{
+    ReplayShaderSnapshot CaptureReplaySnapshot();
+}
+
+public sealed record ReplayShaderUniform(string Name, string Type, string Precision,
+    int? ArrayLength, string? Initializer);
+
+public sealed record ReplayShaderProgram(string? RootPath, string LightMode, string BlendMode,
+    string Preset, IReadOnlyList<string> Includes, IReadOnlyDictionary<string, string> Defines,
+    IReadOnlyList<ReplayShaderUniform> Uniforms, bool Reloaded);
+
+// Value is either a boxed immutable scalar/value-type copy, or null with an explicit reason.
+// Arrays and textures are never retained through this seam.
+public sealed record ReplayShaderParameter(string Name, string Kind, object? Value,
+    string? UnavailableReason);
+
+public sealed record ReplayShaderSnapshot(ReplayShaderProgram Program, bool Mutable,
+    bool HasLighting, string BlendMode, StencilParameters Stencil,
+    IReadOnlyList<ReplayShaderParameter> Parameters);
