<Project>
  <PropertyGroup>
    <!-- These BCL-only checks do not require the game's engine submodule or package catalog. -->
    <ImportDirectoryPackagesProps>false</ImportDirectoryPackagesProps>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Content.Replay.Diagnostic/DefinitionIdAllocator.cs" Link="DefinitionIdAllocator.cs" />
    <Compile Include="../../../Content.Replay.Diagnostic/DefinitionStore.cs" Link="DefinitionStore.cs" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
