     private long _replayAnimationEligibilityRevision;
     public long ReplayAnimationEligibilityRevision => Volatile.Read(ref _replayAnimationEligibilityRevision);
 
+    // Permanent for this component instance. Native layer aliasing is preserved,
+    // but its owner notifications no longer describe every list containing it.
+    private bool _replayAnimationEligibilityFallback;
+    public bool ReplayAnimationEligibilityCacheSafe => !_replayAnimationEligibilityFallback;
+
+    internal void DisableReplayAnimationEligibilityCaching()
+    {
+        _replayAnimationEligibilityFallback = true;
+        InvalidateReplayAnimationEligibility();
+    }
+
     internal void InvalidateReplayAnimationEligibility()
         => Interlocked.Increment(ref _replayAnimationEligibilityRevision);
+
+    private List<Layer>? _readOnlyLayerSource;
+    private ReadOnlyCollection<Layer>? _readOnlyLayers;
+
+    internal void ResetReadOnlyLayers()
+    {
+        _readOnlyLayerSource = null;
+        _readOnlyLayers = null;
+    }
+
+    private ReadOnlyCollection<Layer> GetReadOnlyLayers()
+    {
+        // CopySprite replaces the list. A previously obtained view continues to
+        // describe its original list, as AllLayers did before this wrapper.
+        if (!ReferenceEquals(_readOnlyLayerSource, Layers))
+        {
+            _readOnlyLayerSource = Layers;
+            _readOnlyLayers = Layers.AsReadOnly();
+        }
+        return _readOnlyLayers!;
+    }
+
+    /// <summary>
+    /// Allocation-free diagnostic traversal with an enforced layer budget.
+    /// </summary>
+    /// <remarks>
+    /// Use immediately on the owning engine thread, without intervening layer
+    /// mutations. Neither this span nor the revision counters synchronize lists
+    /// or RSI dictionaries. Never retain it across TickUpdate or FrameUpdate.
+    /// </remarks>
+    public ReadOnlySpan<Layer> GetReplayAnimationLayers(int maximumLayers)
+    {
+        ArgumentOutOfRangeException.ThrowIfNegative(maximumLayers);
+        if (Layers.Count > maximumLayers)
+            throw new InvalidDataException("Diagnostic sprite layer budget exceeded.");
+        return CollectionsMarshal.AsSpan(Layers);
+    }
 }
